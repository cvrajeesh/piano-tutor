// Signing for the iOS and Mac App Store apps. Put your own team in Local.xcconfig next to this file
// (it is ignored by git), for example:
//
//   DEVELOPMENT_TEAM = ABCDE12345
//   APP_BUNDLE_ID = com.example.pianotutor
//
CODE_SIGN_STYLE = Automatic
APP_BUNDLE_ID = com.liskovlabs.middlec
#include? "Local.xcconfig"
PRODUCT_BUNDLE_IDENTIFIER = $(APP_BUNDLE_ID)
