<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required for the Mac App Store. CoreMIDI and audio output work inside the sandbox. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- Lets the app hear an acoustic piano through the microphone (Settings → Microphone).
         Needs NSMicrophoneUsageDescription, which project.yml sets for this target. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
