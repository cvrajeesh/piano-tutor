"%@, finger %lld" = "%1$@, %2$lld번 손가락";
/* VoiceOver: the keys a lesson points out; the placeholder is a list of keys */
"Marked: %@." = "표시된 건반: %@.";
/* VoiceOver: the keys held down; the placeholder is a list of keys */
"Holding %@." = "누르고 있는 건반: %@.";
/* VoiceOver name of a music staff */
"Music staff" = "오선";
/* VoiceOver: an empty staff */
"No notes" = "음표 없음";
/* Read out by VoiceOver after a key is found; the placeholder is the next note to find, such as D */
"Right. Next, %@." = "맞아요. 다음은 %@.";
