# Copy to fastlane/.env (ignored by git) for local releases. On GitHub Actions
# the same values come from repository secrets (see .github/workflows/release.yml).

# App Store Connect API key (Users and Access → Integrations → App Store Connect API).
# Give it the App Manager role, or Admin so match can create certificates.
ASC_KEY_ID=
ASC_ISSUER_ID=
# Defaults to ~/.appstoreconnect/private_keys/AuthKey_<ASC_KEY_ID>.p8
# ASC_KEY_PATH=

# Private git repository where match keeps the encrypted certificates and profiles,
# and the passphrase they are encrypted with.
MATCH_GIT_URL=
MATCH_PASSWORD=

# Optional. Read from Support/iOS/Local.xcconfig when not set.
# TEAM_ID=
# APP_BUNDLE_ID=
